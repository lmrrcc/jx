<idea-plugin>
    <id>dev.jx.language</id>
    <name>JX Java Components</name>
    <vendor url="https://github.com/lmrrcc/jx">JX contributors</vendor>
    <description><![CDATA[Java components and HTML-style markup in .jx files. Integrates IntelliJ's Java plugin for native Java completion, navigation, inspections and mapped source edits, with shared JX compiler services for markup. Requires Java 25. See the project tooling guide for the tested feature and IDE compatibility matrix.]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.lsp</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="JX" language="JX" implementationClass="jx.intellij.JxFileType" fieldName="INSTANCE" extensions="jx"/>
        <lang.parserDefinition language="JX" implementationClass="jx.intellij.JxParserDefinition"/>
        <lang.syntaxHighlighterFactory language="JX" implementationClass="jx.intellij.JxSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="jx.intellij.JxColorSettingsPage"/>
        <codeInsight.lineMarkerProvider language="JX" implementationClass="jx.intellij.JxRunLineMarkerProvider"/>
        <lang.braceMatcher language="JX" implementationClass="jx.intellij.JxBraceMatcher"/>
        <lang.quoteHandler language="JX" implementationClass="jx.intellij.JxQuoteHandler"/>
        <lang.commenter language="JX" implementationClass="jx.intellij.JxCommenter"/>
        <lang.elementManipulator forClass="jx.intellij.JxJavaInjectionHost" implementationClass="jx.intellij.JxJavaHostManipulator"/>
        <lang.importOptimizer language="JX" implementationClass="jx.intellij.JxImportOptimizer"/>
        <fileIndentOptionsProvider implementation="jx.intellij.JxFormattingIndentOptionsProvider"/>
        <lang.formatter language="JX" implementationClass="jx.intellij.JxFormattingModelBuilder"/>
        <preFormatProcessor implementation="jx.intellij.JxFormattingPreProcessor"/>
        <typedHandler implementation="jx.intellij.JxTagTypingHandler"/>
        <enterHandlerDelegate implementation="jx.intellij.JxEnterHandler"/>
        <lang.psiStructureViewFactory language="JX" implementationClass="jx.intellij.JxStructureViewFactory"/>
        <lang.foldingBuilder language="JX" implementationClass="jx.intellij.JxFoldingBuilder"/>
        <multiHostInjector implementation="jx.intellij.JxJavaInjector"/>
        <java.elementFinder implementation="jx.intellij.JxJavaElementFinder" order="first"/>
        <java.shortNamesCache implementation="jx.intellij.JxShortNamesCache"/>
        <psi.referenceContributor language="JX" implementation="jx.intellij.JxMarkupReferences"/>
        <renamePsiElementProcessor implementation="jx.intellij.JxRenameClassProcessor" order="first"/>
        <highlightVisitor implementation="jx.intellij.JxJavaHighlightVisitor"/>
        <lang.substitutor language="JAVA" implementationClass="jx.intellij.JxGeneratedJavaLanguageSubstitutor"/>
        <lang.findUsagesProvider language="JX" implementationClass="jx.intellij.JxFindUsagesProvider"/>
        <useScopeEnlarger implementation="jx.intellij.JxUseScopeEnlarger"/>
        <resolveScopeEnlarger implementation="jx.intellij.JxResolveScopeEnlarger"/>
        <platform.lsp.serverSupportProvider implementation="jx.intellij.JxLspSupportProvider"/>
        <applicationConfigurable id="jx.settings" displayName="JX" parentId="language" instance="jx.intellij.JxConfigurable"/>
        <notificationGroup id="JX Development" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>
    <actions>
        <action id="JX.StartDevelopmentServer" class="jx.intellij.StartDevelopmentAction" text="Start JX Development Server" description="Run the active .jx file's Maven module with automatic browser updates">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="JX.StopDevelopmentServer" class="jx.intellij.StopDevelopmentAction" text="Stop JX Development Server" description="Stop the JX development server and its active build">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="JX.RestartLanguageServer" class="jx.intellij.RestartServerAction" text="Restart JX Language Server" description="Restart the shared JX language server for the current trusted project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
