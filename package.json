{
  "name": "jx-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:proof": "esbuild proof/react-bridge/browser-entry.js --bundle --format=esm --sourcemap --outfile=proof/react-bridge/target/site/application.js",
    "test:proof": "playwright test -c proof/react-bridge/playwright.config.js",
    "build:runtime": "esbuild tests/runtime-browser/browser-entry.js --bundle --format=esm --sourcemap --outfile=tests/runtime-browser/target/site/application.js",
    "test:runtime": "playwright test -c tests/runtime-browser/playwright.config.js",
    "test:counter": "playwright test -c examples/counter-app/playwright.config.js",
    "test:todo": "playwright test -c examples/todo-app/playwright.config.js",
    "test:hot": "playwright test -c tests/hot-reload/playwright.config.js",
    "build:bench": "esbuild tests/conformance/reference/entry.jsx --bundle --format=esm --jsx=automatic --sourcemap --outfile=tests/conformance/target/reference-site/application.js && esbuild tests/conformance/reference/server.jsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=tests/conformance/target/reference-site/server.cjs",
    "build:bench-server": "esbuild tests/conformance/server-entry.js --bundle --platform=node --format=cjs --outfile=tests/conformance/target/jx-server/server.cjs",
    "test:ssr": "npm run build:bench && npm run build:bench-server && playwright test -c tests/conformance/playwright.config.js -g server-render",
    "test:bench": "npm run build:bench && npm run build:bench-server && playwright test -c tests/conformance/playwright.config.js"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": { "@playwright/test": "1.65.1", "esbuild": "0.28.2" }
}
