{
  "name": "jx-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:proof": "esbuild proof/react-bridge/browser-entry.js --bundle --format=esm --sourcemap --outfile=proof/react-bridge/target/site/application.js",
    "test:proof": "playwright test -c proof/react-bridge/playwright.config.js",
    "build:runtime": "esbuild tests/runtime-browser/browser-entry.js --bundle --format=esm --sourcemap --outfile=tests/runtime-browser/target/site/application.js",
    "test:runtime": "playwright test -c tests/runtime-browser/playwright.config.js",
    "test:counter": "playwright test -c examples/counter-app/playwright.config.js",
    "test:todo": "playwright test -c examples/todo-app/playwright.config.js",
    "test:contract": "playwright test -c examples/todo-app/playwright.config.js -g 'contract exact values'",
    "test:packaged": "playwright test -c tests/packaged/playwright.config.js",
    "test:auth": "playwright test -c tests/session/playwright.config.js",
    "build:extension": "java tools/PackageExtension.java",
    "test:extension": "npm run build:extension && playwright test -c examples/mv3-app/playwright.config.js",
    "test:hot": "playwright test -c tests/hot-reload/playwright.config.js",
    "build:bench": "esbuild tests/conformance/reference/entry.jsx --bundle --format=esm --jsx=automatic --sourcemap --outfile=tests/conformance/target/reference-site/application.js && esbuild tests/conformance/reference/server.jsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=tests/conformance/target/reference-site/server.cjs",
    "build:bench-server": "esbuild tests/conformance/server-entry.js --bundle --platform=node --format=cjs --outfile=tests/conformance/target/jx-server/server.cjs",
    "build:bench-production": "esbuild tests/conformance/reference/entry.jsx --bundle --format=esm --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=tests/conformance/target/reference-production/application.js --metafile=tests/conformance/target/reference-production/metafile.json && esbuild tests/conformance/target/jx/browser/entry.mjs --bundle --format=esm --define:process.env.NODE_ENV='\"production\"' --outfile=tests/conformance/target/jx-production/application.js --metafile=tests/conformance/target/jx-production/metafile.json",
    "build:bench-lazy": "esbuild host=tests/conformance/reference/lazy-host.jsx route=tests/conformance/reference/lazy-route.jsx --external:./route.js --bundle --splitting --format=esm --jsx=automatic --sourcemap --chunk-names=shared-[hash] --outdir=tests/conformance/target/reference-lazy/site --metafile=tests/conformance/target/reference-lazy/metafile.json && esbuild host=tests/conformance/lazy-host-entry.js route=tests/conformance/target/lazy-route/application.js --bundle --splitting --format=esm --sourcemap --chunk-names=shared-[hash] --outdir=tests/conformance/target/jx-lazy/site --metafile=tests/conformance/target/jx-lazy/metafile.json",
    "build:lazy": "esbuild host=tests/lazy-boundary/host-entry.js late=tests/lazy-boundary/module/target/browser/application.js --bundle --splitting --format=esm --sourcemap --outdir=tests/lazy-boundary/target/site",
    "test:lazy": "npm run build:lazy && playwright test -c tests/lazy-boundary/playwright.config.js",
    "build:rsc": "esbuild tests/rsc-proof/server-entry.js --bundle --platform=node --format=cjs --packages=external --outfile=tests/rsc-proof/target/server.cjs && webpack --config tests/rsc-proof/webpack.config.cjs",
    "test:rsc": "npm run build:rsc && node --conditions=react-server --test --test-timeout=10000 tests/rsc-proof/server-smoke.test.js tests/rsc-proof/artifacts.test.js tests/rsc-proof/cache.test.js tests/rsc-proof/async-context.test.js tests/rsc-proof/observer-error.test.js && playwright test -c tests/rsc-proof/playwright.config.js",
    "test:ssr": "npm run build:bench && npm run build:bench-server && playwright test -c tests/conformance/playwright.config.js -g 'server-|hydrate-server|static-prerender|static-resume|combined-resource-hydration'",
    "build:ssr-protected": "esbuild tests/protected-ssr/server-entry.js --bundle --platform=node --format=cjs --packages=external --outfile=tests/protected-ssr/target/server.cjs && esbuild tests/protected-ssr/browser-entry.js --bundle --format=esm --outfile=tests/protected-ssr/target/site/application.js --metafile=tests/protected-ssr/target/site/metafile.json",
    "test:ssr-protected": "npm run build:ssr-protected && playwright test -c tests/protected-ssr/playwright.config.js",
    "test:bench": "node --test tests/conformance/report.test.js && npm run build:bench && npm run build:bench-server && npm run build:bench-lazy && npm run build:bench-production && BENCH_REQUIRE_COMPLETE=1 playwright test -c tests/conformance/playwright.config.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "brotli-wasm": "3.0.1",
    "esbuild": "0.28.2",
    "react-server-dom-webpack": "19.3.1",
    "webpack": "5.108.4",
    "webpack-cli": "7.3.1"
  }
}
