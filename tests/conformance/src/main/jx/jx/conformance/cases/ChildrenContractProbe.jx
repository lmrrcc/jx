package jx.conformance.cases;

import jx.Component;
import jx.View;

/** Uses the public children contract without inspecting the framework's View representation. */
@Component
public final class ChildrenContractProbe {
    public record Props(String name, View children) {}

    public static View render(Props props) {
        return CombinedChildrenContract.inspect(props.name(), props.children());
    }
}
