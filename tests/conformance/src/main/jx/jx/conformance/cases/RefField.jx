package jx.conformance.cases;

import jx.Component;
import jx.DomRef;
import jx.View;

/** A field that attaches the ref it receives as an ordinary prop to its input. */
@Component
public final class RefField {
    public record Props(String label, DomRef ref) {}

    public static View render(Props props) {
        return <input ref={props.ref()} aria-label={props.label()} />;
    }
}
