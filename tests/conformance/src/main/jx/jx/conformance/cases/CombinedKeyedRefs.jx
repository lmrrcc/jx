package jx.conformance.cases;

import java.util.List;
import jx.Component;
import jx.Hooks;
import jx.State;
import jx.View;

/** Keyed rows keep their DOM refs through reordering and detach only on actual lifetime changes. */
@Component
public final class CombinedKeyedRefs {
    public static View render() {
        State<Boolean> reversed = Hooks.useState(false);
        State<Boolean> showA = Hooks.useState(true);
        State<Boolean> mounted = Hooks.useState(true);
        State<Integer> revision = Hooks.useState(0);
        State<Integer> tick = Hooks.useState(0);
        List<String> ids = reversed.value() ? List.of("b", "a") : List.of("a", "b");
        return (
            <main>
                <p data-testid="parent-tick">{tick.value()}</p>
                <p data-testid="callback-revision">{revision.value()}</p>
                <button onClick={event -> tick.update(value -> value + 1)}>Rerender parent</button>
                <button onClick={event -> reversed.update(value -> !value)}>Reverse rows</button>
                <button onClick={event -> revision.update(value -> value + 1)}>Replace callbacks</button>
                <button onClick={event -> showA.set(false)}>Remove a</button>
                <button onClick={event -> showA.set(true)}>Restore a</button>
                <button onClick={event -> mounted.set(false)}>Clear rows</button>
                <ul>{mounted.value() ? ids.stream().filter(id -> showA.value() || !id.equals("a"))
                    .map(id -> <CombinedKeyedRefRow key={id} id={id} revision={revision.value()} />).toList() : null}</ul>
            </main>
        );
    }
}
