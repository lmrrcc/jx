package jx.conformance.cases;

import jx.Component;
import jx.Dependencies;
import jx.Hooks;
import jx.State;
import jx.View;
import jx.conformance.Bench;

/** Case batched-updates: two state updates in one event commit once. */
@Component
public final class BatchedUpdates {
    public static View render() {
        State<Integer> left = Hooks.useState(0);
        State<Integer> right = Hooks.useState(0);
        int leftValue = left.value();
        int rightValue = right.value();
        Hooks.useEffect(() -> {
            Bench.log(leftValue + "," + rightValue);
            return null;
        }, Dependencies.always());
        return (
            <main>
                <p role="status">{leftValue + rightValue}</p>
                <button onClick={event -> {
                    left.update(previous -> previous + 1);
                    right.update(previous -> previous + 1);
                }}>Update both</button>
            </main>
        );
    }
}
