package jx.conformance.cases;

import jx.Component;
import jx.Hooks;
import jx.State;
import jx.View;
import jx.react.Resources;

/** Repeated render-time hints must reuse the link already delivered by the server. */
@Component
public final class CombinedResourceHydration {
    private static final String STYLE = "data:text/css,.jx-resource-hydration{}";

    public static View render() {
        State<Integer> count = Hooks.useState(0);
        Resources.preload(STYLE, "style");
        Resources.preload(STYLE, "style");
        return <main>
            <h1>Hydrated resource</h1>
            <p role="status">{count.value()}</p>
            <button onClick={event -> count.update(previous -> previous + 1)}>Increment</button>
        </main>;
    }
}
