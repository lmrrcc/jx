package jx.conformance.cases;

import jx.Component;
import jx.Hooks;
import jx.State;
import jx.View;

/** Case hydrate-root: hydration attaches to server markup without replacing its nodes. */
@Component
public final class HydrateRoot {
    public static View render() {
        State<Integer> count = Hooks.useState(0);
        return (
            <main>
                <p role="status">{count.value()}</p>
                <button onClick={event -> count.update(previous -> previous + 1)}>Increment</button>
            </main>
        );
    }
}
