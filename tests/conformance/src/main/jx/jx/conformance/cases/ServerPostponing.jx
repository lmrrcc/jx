package jx.conformance.cases;

import jx.Component;
import jx.View;
import jx.react.React;

/** A page whose second part waits for data; prerendering it is aborted and later resumed. */
@Component
public final class ServerPostponing {
    public static View render() {
        return <main><h1>shell</h1>{React.suspense(<p>waiting</p>, <ServerSlow />)}</main>;
    }
}
