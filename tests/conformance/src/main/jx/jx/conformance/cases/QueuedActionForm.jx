package jx.conformance.cases;

import jx.ActionState;
import jx.Component;
import jx.Dependencies;
import jx.Hooks;
import jx.State;
import jx.View;
import jx.conformance.ActionQueueControl;

/** Each mounted form owns one native useActionState queue. */
@Component
public final class QueuedActionForm {
    public record Props(ActionQueueControl control) {}

    public static View render(Props props) {
        State<Boolean> ready = Hooks.useState(false);
        Hooks.useEffect(() -> {
            props.control().activate();
            ready.set(true);
            return props.control()::dispose;
        }, Dependencies.of(props.control()));
        ActionState<Integer> total = Hooks.useActionStateAsync(
                (previous, data) -> props.control().submit(previous, data), 0);
        return (
            <form action={total.action()}>
                <label>Step<input name="step" defaultValue="2" /></label>
                <button type="submit" disabled={!ready.value()}>Queue step</button>
                <QueuedActionStatus />
                <p data-testid="queue-pending">{total.pending() ? "pending" : "idle"}</p>
                <p data-testid="queue-total">{total.state()}</p>
            </form>
        );
    }
}
