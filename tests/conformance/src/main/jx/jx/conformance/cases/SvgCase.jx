package jx.conformance.cases;

import jx.Component;
import jx.View;

/** Case svg: SVG elements are created in the SVG namespace with camel-case attributes. */
@Component
public final class SvgCase {
    public static View render() {
        return (
            <main>
                <svg viewBox="0 0 20 20" width="20" height="20" role="img" aria-label="Line">
                    <path strokeWidth={2} stroke="black" d="M0 0L20 20" />
                </svg>
            </main>
        );
    }
}
