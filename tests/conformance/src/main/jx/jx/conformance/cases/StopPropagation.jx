package jx.conformance.cases;

import jx.Component;
import jx.Hooks;
import jx.State;
import jx.View;

/** Case stop-propagation: a stopped event does not reach the ancestor handler. */
@Component
public final class StopPropagation {
    public static View render() {
        State<Integer> outer = Hooks.useState(0);
        State<Integer> inner = Hooks.useState(0);
        return (
            <main>
                <div onClick={event -> outer.update(previous -> previous + 1)}>
                    <button onClick={event -> inner.update(previous -> previous + 1)}>Bubble</button>
                    <button onClick={event -> {
                        event.stopPropagation();
                        inner.update(previous -> previous + 1);
                    }}>Stop</button>
                </div>
                <p role="status">{outer.value()}/{inner.value()}</p>
            </main>
        );
    }
}
