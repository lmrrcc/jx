package jx.conformance.cases;

import jx.*;

@Component
public final class ClassDefaultsAuthoring {
    public static View render() {
        State<Integer> mode = Hooks.useState(0);
        State<Boolean> reset = Hooks.useState(false);
        State<String> inspection = Hooks.useState("none");
        ClassRef<AuthoredDefaultCounter> ref = Hooks.useMemo(ClassDefaultsAuthoring::ref, Dependencies.none());
        Ref<AuthoredDefaultCounter> remembered = Hooks.useRef(null);
        String key = reset.value() ? "replacement" : "stable";
        View child = mode.value() == 0 ? <AuthoredDefaultCounter required="typed" ref={ref} key={key} />
                : mode.value() == 1 ? <AuthoredDefaultCounter initial={0} label={null} required="typed" ref={ref} key={key}><strong>authored child</strong></AuthoredDefaultCounter>
                : <AuthoredDefaultCounter {...new AuthoredDefaultCounter.Props("typed","forwarded",9,null)} key={key} ref={ref} />;
        return <main>
            <button onClick={event -> mode.set(0)}>Omit authored defaults</button>
            <button onClick={event -> mode.set(1)}>Override authored defaults</button>
            <button onClick={event -> mode.set(2)}>Forward authored props</button>
            <button onClick={event -> { remembered.set(ref.current()); inspection.set("remembered"); }}>Remember authored peer</button>
            <button onClick={event -> inspection.set(Boolean.toString(remembered.current() == ref.current()))}>Compare authored peer</button>
            <button onClick={event -> reset.set(true)}>Reset authored key</button>
            <p data-testid="authored-default-inspection">{inspection.value()}</p>
            {child}
        </main>;
    }
    private static ClassRef<AuthoredDefaultCounter> ref() {
        return new ClassRef<>(value -> {
            if (value instanceof AuthoredDefaultCounter peer) return peer;
            throw new IllegalArgumentException("Expected authored default counter");
        });
    }
}
