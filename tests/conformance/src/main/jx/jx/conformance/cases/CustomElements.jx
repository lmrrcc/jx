package jx.conformance.cases;

import jx.Component;
import jx.Hooks;
import jx.State;
import jx.View;

/** Case custom-elements: unknown hyphenated tags render with their attributes and children. */
@Component
public final class CustomElements {
    public static View render() {
        State<String> label = Hooks.useState("first");
        return (
            <main>
                <bench-badge label={label.value()} data-kind="tag" class="badge">content</bench-badge>
                <button onClick={event -> label.set("second")}>Change label</button>
            </main>
        );
    }
}
