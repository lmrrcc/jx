package jx.conformance.cases;

import jx.Component;
import jx.Hooks;
import jx.State;
import jx.View;

/** Case uncontrolled-inputs: default values seed the DOM once; later renders leave user input alone. */
@Component
public final class UncontrolledInputs {
    public static View render() {
        State<Integer> renders = Hooks.useState(0);
        return (
            <main>
                <input aria-label="Free text" defaultValue="initial" />
                <input type="checkbox" aria-label="Option" defaultChecked />
                <select aria-label="Choice" defaultValue="b">
                    <option value="a">A</option>
                    <option value="b">B</option>
                </select>
                <button onClick={event -> renders.update(previous -> previous + 1)}>Rerender</button>
                <p role="status">{renders.value()}</p>
            </main>
        );
    }
}
