package example.distribution;

import jx.Component;
import jx.Hooks;
import jx.State;
import jx.View;

@Component
public final class Counter {
    public record Props(int initial, String label) {}

    public static View render(Props props) {
        State<Integer> count = Hooks.useState(props.initial());
        return (
            <section aria-label={props.label()}>
                <h2>{props.label()}</h2>
                <output>{count.value()}</output>
                <button onClick={event -> count.update(value -> value + 1)}>Increment</button>
                <button onClick={event -> {
                    count.update(value -> value + 1);
                    count.update(value -> value + 1);
                    count.update(value -> value + 1);
                }}>Add three</button>
            </section>
        );
    }
}
