<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.jx</groupId><artifactId>jx-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../../pom.xml</relativePath></parent>
  <artifactId>protected-ssr-view</artifactId>
  <dependencies>
    <dependency><groupId>dev.jx</groupId><artifactId>todo-contract</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.jx</groupId><artifactId>jx-react</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.jx</groupId><artifactId>jx-browser</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.13.4</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>dev.jx</groupId><artifactId>jx-maven-plugin</artifactId><version>${project.version}</version>
    <executions>
      <execution><id>shared-todo-codec</id><goals><goal>record-codecs</goal></goals><configuration>
        <contractTypes><contractType>jx.example.contract.Todo</contractType></contractTypes>
      </configuration></execution>
      <execution><id>jx-view</id><goals><goal>generate</goal><goal>check</goal></goals></execution>
    </executions>
  </plugin></plugins></build>
</project>
