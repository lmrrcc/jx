<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.jx</groupId><artifactId>jx-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>todo-app</artifactId>
  <dependencies>
    <dependency><groupId>dev.jx</groupId><artifactId>jx-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.jx</groupId><artifactId>jx-react</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.jx</groupId><artifactId>jx-elm</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.jx</groupId><artifactId>jx-browser</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.jx</groupId><artifactId>jx-router</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>${teavm.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.13.4</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>dev.jx</groupId><artifactId>jx-maven-plugin</artifactId><version>${project.version}</version><executions>
      <execution><id>jx-sources</id><goals><goal>generate</goal><goal>check</goal></goals></execution>
      <execution><id>jx-browser</id><phase>prepare-package</phase><goals><goal>browser</goal></goals></execution>
    </executions></plugin>
    <plugin><groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId><version>${teavm.version}</version><executions><execution><phase>process-classes</phase><goals><goal>compile</goal></goals></execution></executions><configuration>
      <mainClass>jx.example.todo.BrowserMain</mainClass><targetType>JAVASCRIPT</targetType><jsModuleType>ES2015</jsModuleType>
      <targetDirectory>${project.build.directory}/browser</targetDirectory><targetFileName>application.js</targetFileName>
      <minifying>false</minifying><sourceMapsGenerated>true</sourceMapsGenerated><sourceFilesCopied>true</sourceFilesCopied>
    </configuration></plugin>
  </plugins></build>
</project>
